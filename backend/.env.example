# 🌐 Cloud Environment Variables
# Copy this to .env and fill your values

PORT=5000

# PostgreSQL (Render / Railway / AWS RDS)
DB_HOST=your-db-host.render.com
DB_PORT=5432
DB_NAME=inventory_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT
JWT_SECRET=change_this_to_random_string_32_chars_min
JWT_EXPIRE=7d

# CORS (Frontend URL)
CORS_ORIGIN=https://your-frontend-url.vercel.app

# Optional: Redis for sessions/cache
REDIS_URL=redis://localhost:6379

# Optional: Email for alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Optional: WhatsApp API (UltraMsg)
WHATSAPP_API_KEY=your_ultramsg_key
WHATSAPP_INSTANCE=your_instance_id
